{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/universal-skeleton-ir/1.0.0/schema.json",
  "$comment": "Analyst design artifact. Reference shape only: numerical, semantic, cross-reference and feature checks must be performed by separate validators.",
  "title": "Universal Skeleton IR v1.0 (proposed canonical contract)",
  "type": "object",
  "properties": {
    "format": {
      "const": "universal-skeleton-ir"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "version",
        "sha256",
        "adapter",
        "adapterVersion"
      ],
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "properties": {
        "axes": {
          "const": "x-right-y-up"
        },
        "time": {
          "const": "seconds"
        },
        "angles": {
          "const": "degrees"
        },
        "uvOrigin": {
          "type": "string",
          "enum": [
            "top-left",
            "bottom-left"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "straight-srgba",
            "premultiplied-srgba",
            "straight-linear",
            "premultiplied-linear"
          ]
        },
        "unitsPerPixel": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "axes",
        "time",
        "angles",
        "uvOrigin",
        "color",
        "unitsPerPixel"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "atlases": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atlasPage"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atlasRegion"
          }
        }
      },
      "required": [
        "pages",
        "regions"
      ],
      "additionalProperties": false
    },
    "skeleton": {
      "$ref": "#/$defs/skeleton"
    },
