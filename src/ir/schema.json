      "type": "object",
      "properties": {
        "fps": {
          "type": "number"
        },
        "imagesPath": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioPath": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boneColors": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "attachmentMetadata": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "color": {
                "type": "integer",
                "minimum": 0
              },
              "edges": {
                "type": "array",
