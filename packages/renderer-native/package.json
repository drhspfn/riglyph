{
  "name": "@riglyph/renderer-native",
  "version": "0.16.0",
  "type": "module",
  "license": "MIT",
  "description": "Optional Rust native draw packet renderer with persistent process and binary protocol",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@riglyph/core": "0.16.0",
    "@riglyph/renderer-webgl2": "0.16.0",
    "@riglyph/renderer-cpu": "0.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drhspfn/riglyph.git"
  },
  "publishConfig": {
    "access": "public"
  }
