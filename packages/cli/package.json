{
  "name": "@riglyph/cli",
  "version": "0.15.1",
  "type": "module",
  "license": "MIT",
  "description": "Riglyph command-line importer, converter, inspector and snapshot utility",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./run": "./dist/cli/main.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "riglyph": "./dist/cli/main.js",
    "use-skeleton": "./dist/cli/main.js"
  },
  "dependencies": {
    "@riglyph/core": "0.15.1",
    "@riglyph/runtime": "0.15.1",
    "@riglyph/renderer-webgl2": "0.15.1",
    "@riglyph/renderer-cpu": "0.15.1",
    "@riglyph/importer-sdk": "0.15.1",
    "@riglyph/importer-spine-4.1": "0.15.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drhspfn/riglyph.git"
  },
  "homepage": "https://github.com/drhspfn/riglyph#readme",
  "bugs": {
    "url": "https://github.com/drhspfn/riglyph/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
